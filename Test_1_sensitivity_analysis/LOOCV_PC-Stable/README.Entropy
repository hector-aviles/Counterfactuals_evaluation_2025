source ~/source_code/venv/bin/activate

chmod +x run_pc_sensitivity.sh run_pc_testing.sh

./run_pc_sensitivity.sh ./Shared_CSVs 2>&1 | tee pc_sensitivity_master.log

./run_pc_testing.sh 2>&1 | tee pc_testing_master.log

python3 best_interventions_pc_sensitivity.py --all

