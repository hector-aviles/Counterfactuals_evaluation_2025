Add the original configuration (it is missing)

# Train Config 0
Rscript CBNs_PC_sensitivity.R ./Shared_CSVs --alpha 0.01 --max.sx NULL --test mi --fraction 0.25

# Evaluate Config 0
python3 run_pc_testing.py ./pc_mi_alpha0p01_maxsxNULL_fracp25 --folds 1-78

# Step 3
python3 best_interventions_pc_sensitivity.py --combos pc_mi_alpha0p01_maxsxNULL_fracp25

